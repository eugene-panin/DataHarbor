# App Configuration
ENVIRONMENT=local
LOG_LEVEL=INFO

# Database Credentials
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dataharbor
POSTGRES_USER=dataharbor
POSTGRES_PASSWORD=dataharbor

# ClickHouse OLAP Credentials
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default

# Qdrant vector store (RAG / similarity search)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=dataharbor
QDRANT_VECTOR_SIZE=512

# Observability & Alerting Thresholds
OBSERVABILITY_STALENESS_SLA_HOURS=12
OBSERVABILITY_ANOMALY_THRESHOLD_RATIO=0.3
OBSERVABILITY_HTTP_ERROR_THRESHOLD_RATIO=0.3

# Core notifications (no n8n required)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
# Comma-separated generic JSON webhooks (optional; can point at n8n if you enable it)
NOTIFY_WEBHOOK_URL=
# Legacy aliases (optional) — only used when set
N8N_WEBHOOK_URL=
N8N_ALERT_WEBHOOK_URL=

# Optional egress proxy (single URL or comma-separated list)
PROXY_URL=
PROXY_LIST=

# S3 / Object Storage (SeaweedFS or AWS S3)
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=dataharbor-raw
S3_REGION=us-east-1

# Dagster Configuration
DAGSTER_HOME=/tmp/dagster_home
# Soft-skip invalid bundles at Dagster load (dev only). Default: fail-fast.
# DATAHARBOR_SKIP_INVALID_BUNDLES=1

# AI Auto-Remediation Provider & API Key Configuration
AI_REPAIR_PROVIDER=gemini        # gemini | deepseek | openai | anthropic | ollama
AI_REPAIR_API_KEY=               # Your API Key (or GEMINI_API_KEY / DEEPSEEK_API_KEY / OPENAI_API_KEY)
AI_REPAIR_MODEL=gemini-1.5-flash  # Target model name
OLLAMA_HOST=http://localhost:11434 # Used when AI_REPAIR_PROVIDER=ollama
