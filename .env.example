# App Configuration
ENVIRONMENT=local
LOG_LEVEL=INFO

# Copy to .env before `docker compose up` (Compose reads this file for substitution).
# Shared local-development credentials. Compose and the host CLI derive their
# service-specific variables below from this single source of truth.
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Database Credentials
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54320
POSTGRES_DB=dataharbor
POSTGRES_USER=${ADMIN_USER}
POSTGRES_PASSWORD=${ADMIN_PASSWORD}

# ClickHouse OLAP Credentials
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=${ADMIN_USER}
CLICKHOUSE_PASSWORD=${ADMIN_PASSWORD}
CLICKHOUSE_DB=default

# Qdrant vector store (RAG / similarity search)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=dataharbor
QDRANT_VECTOR_SIZE=512

# Observability & Alerting Thresholds
OBSERVABILITY_STALENESS_SLA_HOURS=12
OBSERVABILITY_ANOMALY_THRESHOLD_RATIO=0.3
OBSERVABILITY_HTTP_ERROR_THRESHOLD_RATIO=0.3

# Grafana is bound to localhost by Compose. Set a non-default password before
# exposing it through a trusted reverse proxy or another network boundary.
GRAFANA_ADMIN_USER=${ADMIN_USER}
GRAFANA_ADMIN_PASSWORD=${ADMIN_PASSWORD}

# n8n (optional profile: docker compose --profile n8n up -d)
# Owner email + bcrypt hash only apply on first bootstrap of an empty n8n volume.
# Regenerate hash after changing ADMIN_PASSWORD, e.g.:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'admin123', bcrypt.gensalt()).decode())"
N8N_ADMIN_EMAIL=admin@dataharbor.local
N8N_INSTANCE_OWNER_FIRST_NAME=Admin
N8N_INSTANCE_OWNER_LAST_NAME=User
# bcrypt hash for ADMIN_PASSWORD=admin123
N8N_INSTANCE_OWNER_PASSWORD_HASH='$2a$10$VcCXQbXtMRCFQmXYLyb2yeeCHmnulnCgg4p79F0xvLoU/ZJyKPM7i'

# Core notifications (no n8n required)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
# Comma-separated generic JSON webhooks (optional; can point at n8n if you enable it)
NOTIFY_WEBHOOK_URL=
# Legacy aliases (optional) — only used when set
N8N_WEBHOOK_URL=
N8N_ALERT_WEBHOOK_URL=

# Named proxy pools. Keep credentials only in your local .env, never commit
# them. Each accepts one URL or a comma-separated list. GeoNode's exported
# ``host:port:user:password`` lines are accepted too.
RESIDENTIAL_PROXY_URL=
RESIDENTIAL_PROXY_LIST=
DATACENTER_PROXY_URL=
DATACENTER_PROXY_LIST=

# Legacy generic pool names remain accepted for older external bundles only.
PROXY_URL=
PROXY_LIST=

# S3 / Object Storage (SeaweedFS or AWS S3)
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=dataharbor-raw
S3_REGION=us-east-1

# Dagster Configuration
DAGSTER_HOME=/opt/dagster/dagster_home
# Soft-skip invalid bundles at Dagster load (dev only). Default: fail-fast.
# DATAHARBOR_SKIP_INVALID_BUNDLES=1

# AI Auto-Remediation Provider & API Key Configuration
AI_REPAIR_PROVIDER=gemini        # gemini | deepseek | openai | anthropic | ollama
AI_REPAIR_API_KEY=               # Your API Key (or GEMINI_API_KEY / DEEPSEEK_API_KEY / OPENAI_API_KEY)
AI_REPAIR_MODEL=gemini-1.5-flash  # Target model name
OLLAMA_HOST=http://localhost:11434 # Used when AI_REPAIR_PROVIDER=ollama
