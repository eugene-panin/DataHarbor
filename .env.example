# DataHarbor `.env` — copy to `.env` before `docker compose up`. Never commit `.env`.
# Default stack only: Postgres, ClickHouse, Qdrant, SeaweedFS, Dagster, Grafana.
# Optional services are not listed here. `harbor up --compose --with-n8n` appends
# n8n keys to `.env` the first time you enable that profile. Bundle extra keys
# (quiz LLM, etc.) are appended to `.env` on `harbor bundle install`.

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Shared local login (Postgres, ClickHouse, Grafana) ----------------------
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# --- Data stores (host CLI; Compose overrides host/port in containers) -------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54320
POSTGRES_DB=dataharbor
POSTGRES_USER=${ADMIN_USER}
POSTGRES_PASSWORD=${ADMIN_PASSWORD}

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=${ADMIN_USER}
CLICKHOUSE_PASSWORD=${ADMIN_PASSWORD}
CLICKHOUSE_DB=default

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=dataharbor
QDRANT_VECTOR_SIZE=512

S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=dataharbor-raw
S3_REGION=us-east-1

# --- Dagster -----------------------------------------------------------------
DAGSTER_HOME=/opt/dagster/dagster_home
# DATAHARBOR_SKIP_INVALID_BUNDLES=1
# DAGSTER_WORKSPACE_NAME=all

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=${ADMIN_USER}
GRAFANA_ADMIN_PASSWORD=${ADMIN_PASSWORD}
