# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
ENV/

# Environment variables
.env
.env.local

# Dagster local storage & state
.dagster/
dagster_home/
*.dagster
apps/dagster_app/workspace.yaml
apps/dagster_app/workspaces/*.yaml
!apps/dagster_app/workspaces/.gitkeep

# Custom bundles stay local/private (platform runtime lives in apps/bundle/)
bundles/*
!bundles/.gitkeep
!bundles/__init__.py
!bundles/demo/

# Custom extractors stay local/private (platform runtime lives in apps/extractor/)
extractors/*
!extractors/.gitkeep
!extractors/__init__.py
!extractors/demo_site/
**/__pycache__/
*.pyc

# Playwright & Browsers
/ms-playwright/
test-results/
.playwright-cli/
output/

# Scratch & Exports
scratch/
exports/
backups/
analysis/
*.md
!README.md
!README.ru.md
!README.uk.md
!README.es.md
!README.tr.md
!AGENTS.md
!.agents/**/*.md
!extractors/demo_site/AGENT.md
!bundles/demo/AGENT.md

# IDE / OS / local tooling
.idea/
.vscode/
.cursor/
.cursorindexingignore
.specstory/
*.swp
*.swo
.DS_Store
.cache/
